{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/aegf-session-start.sh"
      }
    ],
    "sessionEnd": [
      {
        "command": ".cursor/hooks/aegf-session-end.sh"
      }
    ],
    "preToolUse": [
      {
        "command": ".cursor/hooks/aegf-pretooluse-task.sh",
        "matcher": "Task"
      },
      {
        "command": ".cursor/hooks/aegf-agent-log.sh context-read",
        "matcher": "Read"
      }
    ],
    "beforeReadFile": [
      {
        "command": ".cursor/hooks/aegf-agent-log.sh context-read"
      }
    ],
    "subagentStart": [
      {
        "command": ".cursor/hooks/aegf-agent-log.sh subagent-start"
      }
    ],
    "afterAgentThought": [
      {
        "command": ".cursor/hooks/aegf-agent-log.sh agent-thought"
      }
    ],
    "afterShellExecution": [
      {
        "command": ".cursor/hooks/aegf-after-shell-report.sh",
        "matcher": "governance-run-report"
      },
      {
        "command": ".cursor/hooks/aegf-agent-log.sh shell-freshness",
        "matcher": "git (submodule|pull)|setup-v4-repos|governance-check|baseline\\.yaml"
      }
    ]
  }
}
